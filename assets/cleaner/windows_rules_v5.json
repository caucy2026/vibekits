{
  "schemaVersion": 1,
  "catalogVersion": 5,
  "rules": [
    {
      "id": "nuget-http-download-cache",
      "label": "NuGet HTTP 下载缓存",
      "platform": "windows",
      "pathTemplate": "%LOCALAPPDATA%\\NuGet\\v3-cache",
      "category": "developerCache",
      "risk": "safe",
      "defaultEnabled": true,
      "minimumAgeHours": 24,
      "maxDepth": 8,
      "maxEntries": 20000,
      "cleanupAction": "recycle",
      "impact": "仅 HTTP 包下载缓存；需要时 NuGet 会重新下载",
      "source": "Vibekits Windows 软件规则 v5"
    },
    {
      "id": "playwright-browser-downloads",
      "label": "Playwright 浏览器运行时",
      "platform": "windows",
      "pathTemplate": "%LOCALAPPDATA%\\ms-playwright",
      "category": "developerCache",
      "risk": "cautious",
      "defaultEnabled": true,
      "minimumAgeHours": 168,
      "maxDepth": 8,
      "maxEntries": 30000,
      "cleanupAction": "recycle",
      "impact": "可能删除仍被测试项目使用的浏览器版本；下次运行需要重新下载",
      "source": "Vibekits Windows 软件规则 v5"
    },
    {
      "id": "huggingface-model-hub-cache",
      "label": "Hugging Face 模型缓存",
      "platform": "windows",
      "pathTemplate": "%USERPROFILE%\\.cache\\huggingface\\hub",
      "category": "developerCache",
      "risk": "cautious",
      "defaultEnabled": true,
      "minimumAgeHours": 720,
      "maxDepth": 12,
      "maxEntries": 100000,
      "cleanupAction": "recycle",
      "impact": "模型可能很大且重新下载耗时；只建议30天未修改内容并默认不选择",
      "source": "Vibekits Windows 软件规则 v5"
    },
    {
      "id": "torch-model-hub-cache",
      "label": "PyTorch Hub 模型缓存",
      "platform": "windows",
      "pathTemplate": "%USERPROFILE%\\.cache\\torch\\hub",
      "category": "developerCache",
      "risk": "cautious",
      "defaultEnabled": true,
      "minimumAgeHours": 720,
      "maxDepth": 12,
      "maxEntries": 100000,
      "cleanupAction": "recycle",
      "impact": "清理后模型和权重需要重新下载；默认不选择",
      "source": "Vibekits Windows 软件规则 v5"
    },
    {
      "id": "docker-desktop-old-logs",
      "label": "Docker Desktop 旧日志",
      "platform": "windows",
      "pathTemplate": "%LOCALAPPDATA%\\Docker\\log",
      "category": "logs",
      "risk": "cautious",
      "defaultEnabled": true,
      "minimumAgeHours": 168,
      "maxDepth": 8,
      "maxEntries": 20000,
      "includePatterns": ["*.log", "*.txt", "*.json"],
      "cleanupAction": "recycle",
      "impact": "仅一周前诊断日志；Docker 排障期间应保留",
      "source": "Vibekits Windows 软件规则 v5"
    },
    {
      "id": "teams-webview-cache",
      "label": "新版 Teams WebView 缓存",
      "platform": "windows",
      "pathTemplate": "%LOCALAPPDATA%\\Packages\\MSTeams_8wekyb3d8bbwe\\LocalCache\\Microsoft\\MSTeams\\EBWebView\\Default\\Cache",
      "category": "applicationCache",
      "risk": "safe",
      "defaultEnabled": true,
      "minimumAgeHours": 24,
      "maxDepth": 8,
      "maxEntries": 30000,
      "cleanupAction": "recycle",
      "impact": "Teams 会重新生成网页缓存；清理前应退出 Teams",
      "source": "Vibekits Windows 软件规则 v5"
    },
    {
      "id": "visual-studio-installer-packages",
      "label": "Visual Studio 安装器包缓存",
      "platform": "windows",
      "pathTemplate": "%PROGRAMDATA%\\Microsoft\\VisualStudio\\Packages",
      "category": "developerCache",
      "risk": "systemManaged",
      "defaultEnabled": false,
      "minimumAgeHours": 2160,
      "maxDepth": 10,
      "maxEntries": 100000,
      "cleanupAction": "recycle",
      "impact": "可能影响 Visual Studio 修复或离线修改；仅列出90天旧内容并要求明确确认",
      "source": "Vibekits Windows 软件规则 v5"
    }
  ]
}
