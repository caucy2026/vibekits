{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibekits.local/schemas/lmcp-discovery-1.0.schema.json",
  "title": "LMCP Discovery Announcement 1.0",
  "type": "object",
  "additionalProperties": true,
  "required": ["protocol", "protocolVersion", "messageType", "instanceId", "app", "endpoint", "mcp", "security", "ttlSeconds", "sentAt"],
  "properties": {
    "protocol": { "const": "lmcp-discovery" },
    "protocolVersion": { "const": "1.0" },
    "messageType": { "const": "announce" },
    "instanceId": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[A-Za-z0-9._:-]+$" },
    "app": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "name", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 120 },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "version": { "type": "string", "minLength": 1, "maxLength": 40 }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": true,
      "required": ["transport", "port"],
      "properties": {
        "transport": { "enum": ["ssh-stdio", "https-streamable-http", "http-jsonrpc"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": true,
      "required": ["protocolVersions", "capabilityDigest"],
      "properties": {
        "protocolVersions": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "maxLength": 32 } },
        "capabilityDigest": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": true,
      "required": ["pairingRequired", "authMethods", "controlApproval"],
      "properties": {
        "pairingRequired": { "const": true },
        "authMethods": { "type": "array", "contains": { "const": "ssh-ed25519" } },
        "controlApproval": { "enum": ["per-tool", "per-session"] }
      }
    },
    "ttlSeconds": { "type": "integer", "minimum": 8, "maximum": 60 },
    "sentAt": { "type": "string", "format": "date-time" }
  }
}
