{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibekits.local/schemas/lmcp-app-manifest-1.0.schema.json",
  "title": "LMCP Application Manifest 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["instanceId", "app", "endpoint", "mcp", "security"],
  "properties": {
    "instanceId": { "type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[A-Za-z0-9._:-]+$" },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 120 },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "version": { "type": "string", "minLength": 1, "maxLength": 40 }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "port"],
      "properties": {
        "transport": { "enum": ["ssh-stdio", "https-streamable-http"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "path": { "type": "string", "maxLength": 160 },
        "certificateSha256": { "type": "string", "pattern": "^sha256:[A-Fa-f0-9]{64}$" }
      },
      "allOf": [
        {
          "if": { "properties": { "transport": { "const": "https-streamable-http" } } },
          "then": { "required": ["path", "certificateSha256"] }
        }
      ]
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersions", "capabilityDigest"],
      "properties": {
        "protocolVersions": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "maxLength": 32 } },
        "capabilityDigest": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pairingRequired", "authMethods", "controlApproval"],
      "properties": {
        "pairingRequired": { "const": true },
        "authMethods": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "enum": ["ssh-ed25519", "mtls", "oauth-device-code"] } },
        "controlApproval": { "enum": ["per-tool", "per-session"] }
      }
    },
    "ttlSeconds": { "type": "integer", "minimum": 8, "maximum": 60, "default": 12 }
  }
}
