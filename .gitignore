# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/release/
/coverage/
/windows/flutter/ephemeral/

# Prepared DeepSeek Harness runtime is a reproducible build input generated by
# tool/prepare_harness_runtime.ps1. Keep the pinned recipe and MCP source in Git,
# not 32k npm files or the 92 MiB Node executable.
/native/harness/windows/runtime/

# Prepared official MinGit runtime. The pinned, hash-verified recipe is kept in
# Git while the extracted redistributable is supplied to Windows packaging.
/native/git/windows/runtime/

# Local verification output
/_build*.txt
/_doctor*.txt
/_test_out.txt

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/
