# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.recovery/
.test-appdata/
.pub/
/build/
/release/
/bin/*
!/bin/README.md
/coverage/
/.runtime-cache/
/windows/flutter/ephemeral/

# Prepared DeepSeek Harness runtime is a reproducible build input generated by
# tool/prepare_harness_runtime.ps1. Keep the pinned recipe and MCP source in Git,
# not 32k npm files or the 92 MiB Node executable.
/native/harness/windows/runtime/

# Prepared macOS Harness runtime is also reproduced by the pinned preparation
# script. It contains about 30k npm files and a Universal Node binary larger
# than GitHub's single-file limit, so only the recipe and verification scripts
# belong in source control.
/native/harness/macos/runtime/

# Prepared official MinGit runtime. The pinned, hash-verified recipe is kept in
# Git while the extracted redistributable is supplied to Windows packaging.
/native/git/windows/runtime/
/native/git/macos/runtime/
/native/lark_cli/windows/runtime/

# Local verification output
/_build*.txt
/_doctor*.txt
/_test_out.txt
/.tmp/
/tmp/
/.cache/
/dev*.png

# Explicitly gated, environment-specific production E2E probes contain local
# fixture paths and device identities. Keep them local; portable contract and
# integration tests remain tracked.
/test/_live_*

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/
